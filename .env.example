# Organization — configuration (copy to .env and fill in)
# All values have safe defaults in code; this file documents the knobs.

# --- Intake (Phase 1) ---
# Leader's confidence threshold for "understands the task" (0-1)
CONFIDENCE_THRESHOLD=0.85
# Max rounds of clarifying questions before the Leader marks assumptions
QUESTION_BUDGET_ROUNDS=10

# --- Mission codification (Phase 2) ---
# Max re-asks of the user on a rejected mission draft
MISSION_REASK_BUDGET=5

# --- Pods ---
POD_MIN_ROLES=2
POD_MAX_ROLES=6
# Max deliberation rounds per pod before a forced close
POD_MAX_ROUNDS=10

# --- Resourcing ---
# Max ICs a non-manager (department head without an intervening manager) may
# have as direct reports; a manager is hired at the cap
DIRECT_IC_CAP=4

# --- Context / memory ---
# Token budget for an assembled role context (bounded assembly + truncation)
CONTEXT_BUDGET_TOKENS=4000
# Max entries kept in a role's short-term memory
ROLE_MEMORY_MAX_ENTRIES=20

# --- Audit / archives ---
# Rolling window: keep the last N sessions before moving to archives
HISTORY_WINDOW_SESSIONS=50
# Size cap for archives (MB); oldest deleted first beyond this
ARCHIVE_CAP_MB=2048

# --- LLM backend ---
# "stub" = deterministic scripted backend (offline testing, no live model)
# "api"  = a real backend wired behind the same LLMBackend interface
#
# Default below: the localhost setup, matching run_org.bat — a local
# KoboldCpp server hosting Qwen3.8-27B on port 5001 (OpenAI-compatible
# root http://localhost:5001/v1). run_org.bat starts the server for you
# (including the --jinja --jinjatools tool-call flags); if you start
# koboldcpp.exe manually, keep those flags.
# Set LLM_BACKEND=stub for offline runs (no server needed).
LLM_BACKEND=api
LLM_MODEL=Qwen3.8-27B-UD-Q4_K_M.gguf
LLM_BASE_URL=http://localhost:5001/v1
LLM_API_KEY=not-needed
# Structured-output mode for the api backend:
# "tools" = tool calls (default): the role's output schema is a forced tool,
#           so the envelope arrives as the tool's JSON arguments — needs the
#           server's tool-call support (KoboldCpp --jinja --jinjatools, as
#           started by run_org.bat)
# "json"  = legacy response_format json_object (servers without tool support)
LLM_STRUCTURED=tools
# Reply budget (max_tokens) — the max tokens the model may GENERATE per
# response. This is NOT the context window: prompt + reply must fit within
# --contextsize (100000), so max_tokens must leave room for the prompt. Do
# not set it to the full context size. A thinking model's chain-of-thought +
# the submit_output JSON can exceed 8192 tokens and get truncated mid-JSON
# (OpenAIOutputError: "Unterminated string"); 32768 gives generous headroom.
LLM_MAX_TOKENS=32768
# Idle timeout (seconds): the max time to wait for the NEXT streamed chunk.
# This is the httpx `read` timeout — it fails only when the model STOPS
# emitting chunks (a hang), so a long-but-active think never trips it.
#
# Why 1800 (not the 180s code default): on a single 4090 KoboldCpp
# serializes generations. With LLM_MAX_TOKENS=32768 one full reply can take
# ~11-18 min to generate; a request that arrives while the server is finishing
# a previous one waits in the queue emitting NO chunks, so a short idle timer
# runs out and crashes the run (httpx.ReadTimeout). 1800s covers that worst-case
# queue wait (plus long prefills) with margin. A genuinely hung model is still
# detected within 30 min, and the LLM_TIMEOUT_SECONDS wall-clock backstop
# (3600s) remains the ultimate bound.
LLM_IDLE_TIMEOUT_SECONDS=1800
# Wall-clock backstop (seconds): the max time for the ENTIRE request (not the
# idle timeout, which bounds the wait for the NEXT streamed chunk). A
# long-but-active generation (the model keeps emitting chunks) never trips the
# idle timeout, but it does trip the wall-clock backstop if it exceeds this.
# 3600s (1 hour) covers the worst-case queue wait + a full 32768-token reply
# on a single 4090 (11-18 min) with generous margin. A genuinely hung model is
# still detected by the idle timeout (1800s) within 30 min.
LLM_TIMEOUT_SECONDS=3600
# Bounded retries on a timeout (a Read/Connect/Pool timeout): the whole
# streaming request is retried from the start — the model's partial generation
# is lost on a timeout (a stateless HTTP request), so a resume is impossible.
# This is the number of retries AFTER the first attempt (default 3 -> up to 4
# total attempts), with a short backoff (5s, 10s, 15s...) between attempts.
# A parse error or a non-timeout transport error is never retried. Set 0 to
# disable retries (a timeout fails immediately).
LLM_MAX_RETRIES=3

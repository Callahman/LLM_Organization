# Organization — configuration (copy to .env and fill in)
# All values have safe defaults in code; this file documents the knobs.

# --- Intake (Phase 1) ---
# Leader's confidence threshold for "understands the task" (0-1)
CONFIDENCE_THRESHOLD=0.8
# Max rounds of clarifying questions before the Leader marks assumptions
QUESTION_BUDGET_ROUNDS=5

# --- Mission codification (Phase 2) ---
# Max re-asks of the user on a rejected mission draft
MISSION_REASK_BUDGET=3

# --- Pods ---
POD_MIN_ROLES=2
POD_MAX_ROLES=6
# Max deliberation rounds per pod before a forced close
POD_MAX_ROUNDS=5

# --- Resourcing ---
# Max ICs a non-manager (department head without an intervening manager) may
# have as direct reports; a manager is hired at the cap
DIRECT_IC_CAP=3

# --- Context / memory ---
# Token budget for an assembled role context (bounded assembly + truncation)
CONTEXT_BUDGET_TOKENS=4000
# Max entries kept in a role's short-term memory
ROLE_MEMORY_MAX_ENTRIES=20

# --- Audit / archives ---
# Rolling window: keep the last N sessions before moving to archives
HISTORY_WINDOW_SESSIONS=50
# Size cap for archives (MB); oldest deleted first beyond this
ARCHIVE_CAP_MB=1024

# --- LLM backend ---
# "stub" = deterministic scripted backend (offline testing, no live model)
# "api"  = a real backend wired behind the same LLMBackend interface
#
# Default below: the localhost setup, matching run_org.bat — a local
# KoboldCpp server hosting Qwen3.8-27B on port 5001 (OpenAI-compatible
# root http://localhost:5001/v1). run_org.bat starts the server for you
# (including the --jinja --jinjatools tool-call flags); if you start
# koboldcpp.exe manually, keep those flags.
# Set LLM_BACKEND=stub for offline runs (no server needed).
LLM_BACKEND=api
LLM_MODEL=Qwen3.8-27B-UD-Q4_K_M.gguf
LLM_BASE_URL=http://localhost:5001/v1
LLM_API_KEY=not-needed
# Structured-output mode for the api backend:
# "tools" = tool calls (default): the role's output schema is a forced tool,
#           so the envelope arrives as the tool's JSON arguments — needs the
#           server's tool-call support (KoboldCpp --jinja --jinjatools, as
#           started by run_org.bat)
# "json"  = legacy response_format json_object (servers without tool support)
LLM_STRUCTURED=tools
# Generation budget for the model's reply (its thinking + the tool call).
# KoboldCpp's server-side default is 2048, which truncates a thinking model's
# submit_output tool call mid-JSON (an "Unterminated string" parse error);
# 8192 is safe.
LLM_MAX_TOKENS=8192

# environment
.env
.venv/
venv/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.pytest_tmp/
.test_basetemp/
pytest-cache-files-*/
.mypy_cache/

# generated state (audit trail, archives, runtime artifacts) — ignore the
# contents, keep the directory markers. (A `dir/` pattern excludes the whole
# directory, so a `!**/.gitkeep` re-include inside it would never apply; the
# `dir/*` + `!dir/.gitkeep` form is required.)
history/*
!history/.gitkeep
archives/*
!archives/.gitkeep
state/role_memory/*
!state/role_memory/.gitkeep
state/org_chart.json
# C1: the org structure (every department / team directory) — generated state.
departments/*
!departments/.gitkeep
pods/transcripts/*
!pods/transcripts/.gitkeep
pods/artifacts/*
!pods/artifacts/.gitkeep
reports/offloading/*
!reports/offloading/.gitkeep
reports/evaluation/*
!reports/evaluation/.gitkeep
